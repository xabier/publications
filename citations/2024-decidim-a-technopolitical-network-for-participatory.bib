@book{barandiaran2024decidim,
  author = {Barandiaran, Xabier E. and Calleja-López, Antonio and Monterde, Arnau and Romero, Carol},
  title = {Decidim, a Technopolitical Network for Participatory Democracy: Philosophy, Practice and Autonomy of a Collective Platform in the Age of Digital Intelligence},
  year = {2024},
  publisher = {Springer Nature Switzerland},
  address = {Cham, Switzerland},
  isbn = {978-3-031-50783-0 978-3-031-50784-7},
  doi = {10.1007/978-3-031-50784-7},
  url = {https://link.springer.com/10.1007/978-3-031-50784-7},
  abstract = {This book presents Decidim, the free software platform and community for participatory democracy, and the philosophy, practice and autonomy of a collective platform in the age of digital intelligence. Chapter 1 summarizes the nature of the project, its impact, its history and why it was born in the context of cognitive capitalism and the decline of neoliberal "democracies" on the one hand, and the dawn of digital commons and radical democracy on the other. Chapter 2, the most theoretical, reviews contemporary social and democratic theory to explain the radically democratic vision that Decidim aims to achieve. Chapter 3 covers perhaps the most original aspect of the project, its technopolitical crafting: how technical details are assembled to produce specific political effects, and how the community recursively embodies those technical and political mechanisms in its own constitution. Chapter 4 gives a technical description of the infrastructure: the software, the community and the legal framework. Chapter 5, the most philosophical and speculative, recapitulates the book, projects past, present and future challenges and offers a reading of what Decidim is and could be. The book draws on the IAS-Research group's study of the autonomy of the living, transposed to the autonomy of sociotechnical hybrids. It is published open access under a Creative Commons BY-SA licence.},
  keywords = {Collective intelligence, Decidim, Democratic innovation, Digital democracy, Digital platforms, Metadecidim, Network society, Participatory democracy, Participatory governance, Political network, Public-commons partnership, Software development, Techno-politics}
}
