@article{barandiaran2008nature,
  author = {Barandiaran, Xabier E. and Moreno, Alvaro},
  title = {On the nature of neural information: A critique of the received view 50 years later},
  year = {2008},
  journal = {Neurocomputing},
  volume = {71},
  number = {4-6},
  pages = {681-692},
  issn = {0925-2312},
  doi = {10.1016/j.neucom.2007.09.014},
  url = {http://www.sciencedirect.com/science/article/B6V10-4R40SK6-3/2/e01a382756c2cd05eb26c737d6a4102e},
  abstract = {We offer a critical review of the concept of neural information, as received within mainstream neuroscience from Artificial Intelligence. This conception of information is constructed as a conditional probability of a stimulus given a certain neural activation, a correlation that cannot be accessed by the organism and fails to explain its causal organization. We reconstruct an alternative conception of neural information: a pattern of signals that is selected by the organism (as an autonomous system) to contribute to its self-maintenance in virtue of its correlation with external conditions, a correlation that might further be evaluated by the very system.},
  keywords = {Philosophy of neuroscience, Neural information, Autonomous systems, Neurodynamic self-organization, Embodiment, Error detection}
}
