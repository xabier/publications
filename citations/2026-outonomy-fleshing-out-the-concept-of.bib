@book{barandiaran2026outonomy,
  author = {Barandiaran, Xabier E. and Etxeberria, Arantza},
  title = {Outonomy: Fleshing out the Concept of Autonomy Beyond the Individual},
  year = {2026},
  publisher = {Springer Nature Switzerland},
  address = {Cham},
  isbn = {978-3-032-05500-2 978-3-032-05501-9},
  doi = {10.1007/978-3-032-05501-9},
  url = {https://link.springer.com/10.1007/978-3-032-05501-9},
  abstract = {This volume, edited by Xabier E. Barandiaran and Arantza Etxeberria, is the integrated result of the research project Outonomy. It gathers a cross-disciplinary exploration of autonomy that moves beyond the classic, self-sufficient, abstract, rational and detached model of the individual inherited from modernity. Instead, it develops the concept of outonomy to capture how autonomy is constituted through relations: with environments, other agents, technologies, institutions, and social-ecological systems. The opening chapter outlines four key properties that articulate this shift (interactivity, collectivity, extensionality and environmentality) along two fundamental dimensions (integration and sustainability), reframing autonomy as something that emerges across scales of interaction and dependence rather than something sealed within an isolated individual. The volume is organized into four parts: Theoretical Insights (the conceptual stakes of outonomy, control and organization in biological systems); The Fabric of Life (environments and asymmetries, the origins of life, reproduction, menstrual health); The Psychic Self and Its Environment (psychiatry, salutogenesis, pain); and Technology, Ecology \& Politics (technocomplexity, the limits of autonomy in social-ecological systems, subjects-in-common, mindshaping and adaptive preferences).},
  keywords = {Outonomy, Autonomy, Human autonomy, Animal autonomy, Biology and politics, Contemporary philosophy of autonomy}
}
